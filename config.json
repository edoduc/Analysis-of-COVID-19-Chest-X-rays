{
    "image_size": 299,
    "model_image_size": 224,

    "paths": {
        "raw_data_dir": "data/raw/COVID-19_Radiography_Dataset"
    },

    "feature_extraction": {
        "lbp": {
            "radius": 3,
            "method": "uniform"
        },
        "hog": {
            "hog_image_size": [160, 160],
            "orientations": 9,
            "pixels_per_cell": [32, 32],
            "cells_per_block": [2, 2],
            "block_norm": "L2-Hys"
        }
    },

    "models": {
        "seed": 42,
        "test_size": 0.2,
        "svm": {
            "kernel": "rbf",
            "class_weight": "balanced",
            "random_state": 42
        },
        "rf": {
            "n_estimators": 100,
            "class_weight": "balanced",
            "random_state": 42
        },
        "xgb": {
            "n_estimators": 150,
            "learning_rate": 0.1,
            "max_depth": 4,
            "random_state": 42
        }
    }
}
